# Start with demo mode; no API key is required.
ANALYST_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Supabase project URL and publishable/anon key (backend verifies access tokens via Auth).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: STORAGE_PATH defaults to backend/data/portfoliolens.sqlite3.
