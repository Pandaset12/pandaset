# Start with the fictional demo provider; no data API key is required.
ANALYST_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176
# Supabase project credentials for v1 and v2 auth. An explicit legacy anon key
# takes precedence for v1; otherwise v1 uses the publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Optional adjusted daily market data for v1.
MARKET_DATA_PROVIDER=sample
# Optional real-time quote snapshots (IEX feed, separate from daily analysis history).
ALPACA_API_KEY=
ALPACA_API_SECRET=
MARKET_DATA_TIMEOUT_SECONDS=15
TWELVE_DATA_API_KEY=
# Optional: STORAGE_PATH defaults to backend/data/portfoliolens.sqlite3.

# Event-aware What-if Lab stays off until configured and reviewed.
EVENT_LAB_ENABLED=false
EVENT_LAB_PUBLIC_ENABLED=false
EVENT_LAB_PROBABILITY_ENABLED=false
# Internal/invited stage: comma-separated verified Supabase user UUIDs. Empty denies all when public is false.
EVENT_LAB_ALLOWED_USER_IDS=
SUPABASE_SIGNING_MODE=asymmetric
MONGO_URI=
MONGO_DATABASE=portfoliolens
TWELVE_DATA_DISPLAY_RIGHTS_CONFIRMED=false
TWELVE_DATA_CACHE_RIGHTS_CONFIRMED=false
FRED_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
APPROVED_NEWS_DOMAINS=
EVENT_MAX_ACTIVE_JOBS_PER_USER=3
EVENT_MAX_MESSAGES_PER_RUN=100
