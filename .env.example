# Copy to .env.local at the repository root. Vite exposes VITE_ variables in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional automatic stock and fund logos. Use a Logo.dev publishable key (pk_),
# restricted to the site's production origin. Missing keys show ticker marks.
VITE_LOGO_DEV_PUBLISHABLE_KEY=

# Optional local backend proxy target.
API_PROXY_TARGET=http://127.0.0.1:8000
